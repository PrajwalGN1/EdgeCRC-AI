<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xxl">

        <!-- Top Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:id="@+id/tvBatchTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_batch_analysis"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvBatchSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/subtitle_batch_analysis"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEngineStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="FP32 ONNX Runtime · Threshold 0.83 · CPUExecutionProvider"
                    android:textSize="11sp"
                    app:chipIcon="@drawable/ic_check_circle"
                    app:chipIconTint="@color/status_success"
                    app:chipBackgroundColor="@color/app_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Ingestion Controls Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPECIMEN INGESTION"
                    style="@style/TextAppearance.CrcMultimodal.SectionHeader" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectBatchFiles"
                    style="@style/Widget.CrcMultimodal.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_select_batch_files"
                    app:icon="@drawable/ic_description"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp" />

                <LinearLayout
                    android:id="@+id/layoutIngestSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvIngestSummaryCounts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Selected: 0 | Accepted: 0 | Rejected: 0"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvBatchIdLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Batch ID: BATCH-20261023-..."
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartBatch"
                    style="@style/Widget.CrcMultimodal.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_run_batch"
                    android:enabled="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Batch Progress Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBatchProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_stroke"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BATCH EXECUTION IN PROGRESS"
                    style="@style/TextAppearance.CrcMultimodal.SectionHeader"
                    android:textColor="@color/primary" />

                <ProgressBar
                    android:id="@+id/progressBarBatch"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/primary" />

                <TextView
                    android:id="@+id/tvBatchProgressStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Initializing sequential inference..."
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvBatchProgressCounts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Completed: 0 | Failed: 0 | Pending: 0"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelBatch"
                    style="@style/Widget.CrcMultimodal.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_cancel_batch"
                    android:textColor="@color/status_failed"
                    app:strokeColor="@color/status_failed" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Batch Summary Statistics Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBatchSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_stroke"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COHORT EVALUATION METRICS"
                    style="@style/TextAppearance.CrcMultimodal.SectionHeader" />

                <TextView
                    android:id="@+id/tvSummaryMsiCounts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="MSI: 0 (0.0%) | MSS: 0 (0.0%)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvSummaryLatencies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mean Latency: 0.0ms | Median: 0.0ms | Duration: 0ms"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvSummaryArchivedCounts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Archived Specimens: 0 (Excluded from active cohort)"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportReport"
                    style="@style/Widget.CrcMultimodal.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_export_batch_report"
                    app:icon="@drawable/ic_description"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="@color/primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Specimen Results List Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <!-- Header Row: Title & Select Toggle Button -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="SPECIMEN TRACEABILITY &amp; MANAGEMENT"
                        style="@style/TextAppearance.CrcMultimodal.SectionHeader" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleSelection"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Select"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />
                </RelativeLayout>

                <!-- Search Input Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBatchSearch"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
                    app:boxCornerRadiusTopStart="@dimen/button_corner_radius"
                    app:endIconMode="clear_text"
                    app:startIconDrawable="@drawable/ic_search"
                    app:startIconTint="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBatchSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Search specimen identifier…"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Filter Chips -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterAll"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="All" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterMsi"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MSI Predicted" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterMss"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MSS Predicted" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterExcluded"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rejected/Failed" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterArchived"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Archived" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Selection Mode Action Toolbar -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSelectionToolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:cardCornerRadius="@dimen/card_corner_radius_sm"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/app_surface_variant"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_stroke"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <!-- Top row: Selection Counts & Selection Utility Buttons -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tvBatchSelectedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:text="0 selected"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnBatchSelectAll"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:text="Select All"
                                    android:textSize="11sp"
                                    android:textColor="@color/primary" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnBatchClearSelection"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:text="Clear"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary" />
                            </LinearLayout>
                        </RelativeLayout>

                        <!-- Bottom row: Bulk Action Buttons (Export PDF, Archive/Restore, Delete) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Bulk Export PDF -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBulkExportPdf"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:minHeight="50dp"
                                android:minWidth="0dp"
                                android:layout_weight="1.32"
                                android:layout_marginEnd="6dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:text="Export PDF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.01"
                                android:singleLine="true"
                                android:maxLines="1"
                                android:includeFontPadding="false"
                                android:textColor="@color/bulk_action_fg_selector"
                                app:backgroundTint="@color/bulk_action_surface"
                                app:strokeColor="@color/bulk_action_stroke_selector"
                                app:strokeWidth="1dp"
                                app:icon="@drawable/ic_picture_as_pdf"
                                app:iconSize="18dp"
                                app:iconPadding="6dp"
                                app:iconGravity="textStart"
                                app:iconTint="@color/bulk_action_fg_selector"
                                app:cornerRadius="@dimen/button_corner_radius" />

                            <!-- Bulk Archive / Restore -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBulkArchive"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:minHeight="50dp"
                                android:minWidth="0dp"
                                android:layout_weight="1.10"
                                android:layout_marginEnd="6dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:text="Archive"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.01"
                                android:singleLine="true"
                                android:maxLines="1"
                                android:includeFontPadding="false"
                                android:textColor="@color/bulk_action_fg_selector"
                                app:backgroundTint="@color/bulk_action_surface"
                                app:strokeColor="@color/bulk_action_stroke_selector"
                                app:strokeWidth="1dp"
                                app:icon="@drawable/ic_history"
                                app:iconSize="18dp"
                                app:iconPadding="6dp"
                                app:iconGravity="textStart"
                                app:iconTint="@color/bulk_action_fg_selector"
                                app:cornerRadius="@dimen/button_corner_radius" />

                            <!-- Bulk Delete (Separated & Distinct) -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBulkDelete"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:minHeight="50dp"
                                android:minWidth="0dp"
                                android:layout_weight="0.98"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:text="Delete"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.01"
                                android:singleLine="true"
                                android:maxLines="1"
                                android:includeFontPadding="false"
                                android:textColor="@color/bulk_delete_fg_selector"
                                app:backgroundTint="@color/bulk_action_surface"
                                app:strokeColor="@color/bulk_delete_stroke_selector"
                                app:strokeWidth="1dp"
                                app:icon="@drawable/ic_delete_outline"
                                app:iconSize="18dp"
                                app:iconPadding="6dp"
                                app:iconGravity="textStart"
                                app:iconTint="@color/bulk_delete_fg_selector"
                                app:cornerRadius="@dimen/button_corner_radius" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBatchSpecimens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_batch_specimen" />

                <TextView
                    android:id="@+id/tvEmptyBatchList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:text="No specimen bundles imported yet.\nTap 'Import Authentic Feature Bundles' to start."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Disclaimer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/disclaimer_short"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>
</ScrollView>
