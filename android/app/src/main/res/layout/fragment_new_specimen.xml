<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xxl">

        <!-- ============================================== -->
        <!-- SECTION A: FEATURE BUNDLE IMPORT               -->
        <!-- ============================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECTION A: FEATURE BUNDLE"
            style="@style/TextAppearance.CrcMultimodal.SectionHeader"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImportBundle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_description"
                        app:tint="@color/primary"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Feature Bundle"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Import a bundle containing precomputed vision and clinical-text embeddings."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Supported formats: .crcbundle, .json, or separate vision/text .npy files"
                    android:textColor="@color/text_supporting"
                    android:textSize="12sp" />

                <!-- Ingestion Source Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectBundleFile"
                        style="@style/Widget.CrcMultimodal.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Choose Bundle File"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_description"
                        app:iconGravity="textStart"
                        app:iconSize="16dp"
                        app:iconTint="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectSeparatePair"
                        style="@style/Widget.CrcMultimodal.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Import Separate Pair"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_layers"
                        app:iconGravity="textStart"
                        app:iconSize="16dp"
                        app:iconTint="@color/secondary" />
                </LinearLayout>

                <!-- Detailed Ingestion Metadata Container -->
                <LinearLayout
                    android:id="@+id/layoutIngestionDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_badge_pill"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvValidationStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/status_success_bg"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="VALIDATED"
                            android:textColor="@color/status_success"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSpecimenIdDisplay"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="ID: TCGA-A6-3807"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSelectedFilename"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="File: TCGA-A6-3807.crcbundle"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tvVisionShapeDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Vision: [1, 613, 1024] · 613 patches · Float32"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tvTextShapeDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Clinical Text: [1, 768] · ClinicalBERT · Float32"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tvErrorExplanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/status_error"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:visibility="gone" />

                    <!-- Provenance Integrity Note -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Note: Checksum verifies byte-level file integrity. It does not establish digital signatures or authenticated provenance."
                        android:textColor="@color/text_supporting"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/layoutIngestionActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConfirmImport"
                            style="@style/Widget.CrcMultimodal.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="Confirm Import"
                            android:textSize="13sp"
                            app:icon="@drawable/ic_check_circle"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Backward-compatible Import Status Banner -->
                <LinearLayout
                    android:id="@+id/layoutImportStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/status_success_bg"
                    android:padding="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/ivImportStatusIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/status_success"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvImportStatusDetails"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Authentic bundle verified and loaded into secure workstation storage."
                        android:textColor="@color/status_success"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================== -->
        <!-- SECTION B: RESEARCH CASE DETAILS               -->
        <!-- ============================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECTION B: RESEARCH CASE DETAILS"
            style="@style/TextAppearance.CrcMultimodal.SectionHeader"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <!-- Case ID Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCaseId"
                        style="@style/Widget.CrcMultimodal.TextInputLayout.SpecimenField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Research Case ID"
                        app:placeholderText="CRC-2026-003"
                        app:helperText="Enter a unique, de-identified identifier for this specimen."
                        app:helperTextEnabled="true"
                        app:errorEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCaseId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:fontFamily="monospace"
                            android:textColor="@color/field_text_primary"
                            android:textColorHint="@color/field_text_hint"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Auto-Generate Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAutoGenerateId"
                        style="@style/Widget.CrcMultimodal.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="4dp"
                        android:text="Generate ID"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_refresh"
                        app:iconSize="16dp"
                        app:iconTint="@color/primary" />
                </LinearLayout>

                <!-- Specimen Description Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSpecimenDescription"
                    style="@style/Widget.CrcMultimodal.TextInputLayout.SpecimenField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Specimen Description"
                    app:placeholderText="Ascending colon biopsy, FFPE"
                    app:helperText="Record the tissue site and specimen preparation details."
                    app:helperTextEnabled="true"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSpecimenDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="3"
                        android:textColor="@color/field_text_primary"
                        android:textColorHint="@color/field_text_hint"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================== -->
        <!-- SECTION C: CLINICAL RESEARCH CONTEXT           -->
        <!-- ============================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECTION C: CLINICAL RESEARCH CONTEXT"
            style="@style/TextAppearance.CrcMultimodal.SectionHeader"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilResearchContext"
                    style="@style/Widget.CrcMultimodal.TextInputLayout.SpecimenField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Clinical Observations"
                    app:helperText="Enter the approved, de-identified context associated with this research specimen."
                    app:helperTextEnabled="true"
                    app:counterEnabled="true"
                    app:counterMaxLength="50000">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etResearchContext"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:textColor="@color/field_text_primary"
                        android:textColorHint="@color/field_text_hint"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Technical Pipeline Explanation Banner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_badge_pill"
                    android:padding="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_info_outline"
                        app:tint="@color/primary"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Pipeline Note: The fusion model evaluates precomputed ClinicalBERT embeddings. Clinical observations entered above are stored with the case record and do not recalculate the language embedding on-device."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================== -->
        <!-- SECTION D: HISTOPATHOLOGY PATCH COUNT          -->
        <!-- ============================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECTION D: HISTOPATHOLOGY SPECIMEN INPUT"
            style="@style/TextAppearance.CrcMultimodal.SectionHeader"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slide Patch Count (N)"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Number of slide image patches to evaluate in the vision sequence:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Detected Patch Count Container (Read-Only) -->
                <LinearLayout
                    android:id="@+id/layoutDetectedPatchCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvDetectedPatchCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="Awaiting specimen tensor"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPatchCountSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="(Determined automatically from authentic bundle)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Protocol Policy Notice -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvNewSpecimenProtocolBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="Protocol 1 (Capped ≤ 1,000)"
                        android:textColor="@color/secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvNewSpecimenTensorDim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shape: [1, 10, 1024]"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Precomputed PHIKON-V2 ViT-B embeddings [1, N, 1024] are prepared for native on-device inference without cloud dependency."
                    android:textColor="@color/text_supporting"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================== -->
        <!-- SECTION E: REVIEW & ACTIONS                    -->
        <!-- ============================================== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartInference"
            style="@style/Widget.CrcMultimodal.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Run Inference"
            app:icon="@drawable/ic_speed"
            app:iconGravity="textStart"
            app:iconPadding="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinueToReview"
                style="@style/Widget.CrcMultimodal.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Review Details"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveDraft"
                style="@style/Widget.CrcMultimodal.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="@string/btn_save_draft"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelNewSpecimen"
                style="@style/Widget.CrcMultimodal.Button.Text"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.8"
                android:layout_marginStart="4dp"
                android:text="Cancel"
                android:textSize="12sp"
                android:textColor="@color/text_supporting" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
