<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardBatchSpecimenItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="@dimen/card_corner_radius_sm"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Multi-Selection Checkbox -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbItemSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:visibility="gone"
            android:contentDescription="Select specimen"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top row: Specimen ID & Class Badge -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvItemSpecimenId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:fontFamily="monospace"
                    tools:text="TCGA-A6-3807" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipItemClass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="MSS (Class 0)"
                    tools:visibility="visible" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipItemStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textSize="10sp"
                    tools:text="VALIDATED" />
            </RelativeLayout>

            <!-- Prediction Details Row -->
            <TextView
                android:id="@+id/tvItemProbability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone"
                tools:text="MSI Probability: 0.0023 | Raw Logit: -6.0616"
                tools:visibility="visible" />

            <!-- Metrics Row: Patches & Latency -->
            <TextView
                android:id="@+id/tvItemMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                tools:text="613 patches · 22ms inference · CRCB v2" />

            <!-- Digest & Provenance Row -->
            <TextView
                android:id="@+id/tvItemDigest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:textColor="@color/text_supporting"
                tools:text="SHA-256: 66ffd834... · AUTHENTIC_IMPORTED" />

            <!-- Protocol & Routing Note Row -->
            <TextView
                android:id="@+id/tvItemProtocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:visibility="gone"
                tools:text="Protocol 2 (Uncapped: 2,296 patches)"
                tools:visibility="visible" />

            <!-- Error Message Container -->
            <TextView
                android:id="@+id/tvItemError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/status_failed"
                android:visibility="gone"
                tools:text="Error: Duplicate specimen identifier within batch"
                tools:visibility="visible" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
