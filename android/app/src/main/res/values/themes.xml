<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme inheriting from MaterialComponents DayNight NoActionBar -->
    <style name="Theme.CrcMultimodal" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Brand Tokens -->
        <item name="colorPrimary">@color/secondary</item>
        <item name="colorPrimaryVariant">@color/secondary_variant</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary Tokens -->
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/primary_variant</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>

        <!-- System Bars (Light Mode: subtle status bar with dark icons) -->
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@color/background_light</item>

        <!-- Component Styling Overrides -->
        <item name="materialCardViewStyle">@style/Widget.CrcMultimodal.CardView</item>
        <item name="materialButtonStyle">@style/Widget.CrcMultimodal.Button.Primary</item>
    </style>

    <!-- Custom Material Card Default Style -->
    <style name="Widget.CrcMultimodal.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="strokeColor">@color/card_stroke_light</item>
        <item name="cardBackgroundColor">@color/surface_light</item>
    </style>

    <!-- Primary Action Button Style -->
    <style name="Widget.CrcMultimodal.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/secondary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/card_corner_radius_sm</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Secondary Outlined Button Style -->
    <style name="Widget.CrcMultimodal.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/secondary</item>
        <item name="strokeColor">@color/secondary</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/card_corner_radius_sm</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
    </style>

    <!-- Section Header Text -->
    <style name="TextAppearance.CrcMultimodal.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
</resources>
